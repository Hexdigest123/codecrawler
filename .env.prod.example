# =============================================================================
# CodeCrawler — PRODUCTION environment template.
# Copy to `.env` on the VPS and fill in every blank secret.
# Hostnames `db` and `redis` are the docker-compose.prod.yml service names.
# Secrets stay BLANK in this file — never commit real values.
# =============================================================================

# ---- Infra / runtime ----
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://codecrawler.merckel.dev
# Compose service hostnames (not localhost):
# The password in DATABASE_URL MUST equal POSTGRES_PASSWORD below.
POSTGRES_USER=codecrawler
POSTGRES_PASSWORD=
POSTGRES_DB=codecrawler
DATABASE_URL=postgresql://codecrawler:@db:5432/codecrawler
REDIS_URL=redis://redis:6379

# ---- Public URLs / branding ----
PUBLIC_APP_NAME=CodeCrawler
PUBLIC_WEB_URL=https://codecrawler.merckel.dev
PUBLIC_API_URL=https://codecrawler.merckel.dev
PUBLIC_SITE_URL=https://codecrawler.merckel.dev
# Base URL used in outgoing webhooks (VCS providers must reach this host).
WEBHOOK_PUBLIC_URL=https://codecrawler.merckel.dev

# ---- Auth (Better Auth) ----
BETTER_AUTH_URL=https://codecrawler.merckel.dev
BETTER_AUTH_SECRET=
# 32-byte hex/base64 key used to encrypt stored VCS tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Optional GitHub OAuth (social login). Leave blank to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- AI gateway (OpenRouter) + tracing ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-ultra-253b-instruct
AI_TIMEOUT_MS=180000
CREDITS_PER_USD=1333
# LangSmith tracing is opt-in; leave LANGCHAIN_TRACING_V2=false in prod unless
# you are actively debugging.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codecrawler

# ---- VCS providers / webhooks ----
# GitHub App (production adapter). PEM newlines encoded as \n on one line.
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=
# Shared webhook secrets per provider (must match the provider's webhook config).
GH_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
GITEA_WEBHOOK_SECRET=
# GH_TEST_PAT is DEV-ONLY (local adapter validation) — do NOT set in prod.

# ---- Billing (Mollie) ----
# Use a live_ key in prod (test_ keys are dev only).
MOLLIE_API_KEY=
MOLLIE_REDIRECT_URL=https://codecrawler.merckel.dev/billing/return
MOLLIE_WEBHOOK_URL=https://codecrawler.merckel.dev/api/payments/webhook

# ---- Email (SMTP) ----
# Replace the dev Mailpit (127.0.0.1:1025) with your real transactional SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="CodeCrawler <noreply@codecrawler.merckel.dev>"

# ---- Security scanning (Snyk) ----
SNYK_TOKEN=
SNYK_API=https://api.snyk.io
SNYK_ORG_ID=

# ---- Review / scan limits ----
REVIEW_MAX_DIFF_BYTES=1500000
REVIEW_MAX_SLICES=16
SECURITY_SCAN_TIMEOUT_MS=900000

# ---- Analytics (Plausible) ----
PUBLIC_PLAUSIBLE_DOMAIN=codecrawler.merckel.dev
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ---- Rate limiting (enforced by the API; defaults shown) ----
# Uncomment to override. Blank/commented = built-in defaults apply.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10

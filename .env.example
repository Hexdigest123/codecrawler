NODE_ENV=development
PUBLIC_APP_NAME=CodeCrawler
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:5173
PORT=3001
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_USER=codecrawler
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codecrawler
DATABASE_URL=postgresql://codecrawler:postgres@localhost:5432/codecrawler
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-ultra-253b-instruct
AI_TIMEOUT_MS=180000
CREDITS_PER_USD=1333
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codecrawler
MOLLIE_API_KEY=test_REPLACE_ME
MOLLIE_REDIRECT_URL=http://localhost:5173/billing/return
MOLLIE_WEBHOOK_URL=http://localhost:3001/api/payments/webhook
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="CodeCrawler <noreply@codecrawler.local>"
PUBLIC_PLAUSIBLE_DOMAIN=localhost
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
REVIEW_MAX_DIFF_BYTES=1500000
REVIEW_MAX_SLICES=16

# GitHub (PAT-based). Connect a personal access token via team settings → VCS
# for production. GH_TEST_PAT is a DEV-ONLY escape hatch for local adapter
# validation (revoke after). PRs are discovered via polling, not webhooks.
GH_TEST_PAT=

# PR polling — the worker lists open PRs for projects with polling_enabled=true
# on this cron and enqueues reviews for any new head sha.
# PR_POLL_CRON="*/5 * * * *"
# Shared secret protecting the internal poll endpoint (set to enable polling).
INTERNAL_API_KEY=
# Where the worker reaches the API for internal calls (defaults to PUBLIC_API_URL).
# INTERNAL_API_URL=http://api:3001

NODE_ENV=development
PUBLIC_APP_NAME=CodeCrawler
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:5173
PORT=3001
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
# Optional rotation ring — comma-separated "id:base64" pairs. id 0 must equal
# TOKEN_ENCRYPTION_KEY; other ids add new keys. The first entry is the active
# encryption key; the rest are accepted only for decryption. Leave unset to use
# TOKEN_ENCRYPTION_KEY only.
# Example for rotating to a new key without dropping the old one:
#   TOKEN_ENCRYPTION_KEYS=1:<new base64>,0:<legacy base64>
# TOKEN_ENCRYPTION_KEYS=
POSTGRES_USER=codecrawler
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codecrawler
DATABASE_URL=postgresql://codecrawler:postgres@localhost:5432/codecrawler
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-ultra-253b-instruct
AI_TIMEOUT_MS=180000
CREDITS_PER_USD=1333
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codecrawler
MOLLIE_API_KEY=test_REPLACE_ME
MOLLIE_REDIRECT_URL=http://localhost:5173/billing/return
MOLLIE_WEBHOOK_URL=http://localhost:3001/api/payments/webhook
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="CodeCrawler <noreply@codecrawler.local>"
PUBLIC_PLAUSIBLE_DOMAIN=localhost
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
REVIEW_MAX_DIFF_BYTES=1500000
REVIEW_MAX_SLICES=16
